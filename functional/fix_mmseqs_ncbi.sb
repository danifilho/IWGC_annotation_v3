#!/bin/bash --login
#SBATCH --job-name=PhaMi_v3_ncbi
#SBATCH --partition=general-long
#SBATCH --time=2-00:00:00
#SBATCH --cpus-per-task=20
#SBATCH --mem=200G
#SBATCH --output=%x_%j.out
# Re-run of the Snakefile's mmseqs2 rule for the 'ncbi' DB (identical command),
# but with a private tmp dir: in the main run the three mmseqs easy-search jobs
# shared /tmp and the ncbi one died with "Could not create symlink of /tmp/...".
set -euo pipefail
WD=/mnt/gs21/scratch/dasilvaf/iwgc_pipeline_v3/functional
cd "$WD"
export PATH="$HOME/miniforge3/bin:$PATH"
mkdir -p tmp_mmseqs_ncbi
singularity exec -B "$WD:/data" "$WD/images/mmseqs2.sif" /bin/bash -c \
  "cd /data && mmseqs easy-search gff_read_output/PhaMi.aa databases/current/GenomesDatabase.v1.prot mmseqs_output/PhaMi_ncbi.ofmt6.partial /data/tmp_mmseqs_ncbi --threads 20 --format-mode 0 --start-sens 2 -s 7 --sens-steps 3"
mv mmseqs_output/PhaMi_ncbi.ofmt6.partial mmseqs_output/PhaMi_ncbi.ofmt6
rm -rf tmp_mmseqs_ncbi
echo "hits: $(wc -l < mmseqs_output/PhaMi_ncbi.ofmt6)  queries: $(cut -f1 mmseqs_output/PhaMi_ncbi.ofmt6 | sort -u | wc -l)"
